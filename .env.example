# Database and dataset locations (relative paths are resolved from the working directory)
COLDCHAIN_DB=data/coldchain.db
COLDCHAIN_DATASET=data/sensor_readings.json

# Optional per-truck / per-cargo policy overrides
# COLDCHAIN_POLICY_FILE=config/policy.example.json

# Demo conveniences: seed the provided dataset on first boot and enable the replay button
COLDCHAIN_SEED_DEMO=false
COLDCHAIN_DEMO_MODE=false

# Optional LLM-generated alert summaries. The deterministic template is always present.
# COLDCHAIN_LLM_ENABLED=true
# COLDCHAIN_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Slack-compatible webhook for OPENED / RESOLVED alert events
# COLDCHAIN_WEBHOOK_URL=https://hooks.slack.com/services/...
